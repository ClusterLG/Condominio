# Archivo de configuración de variables de entorno para Condominio Base
# En hosting de producción, copia este archivo como .env y coloca tus credenciales reales

DB_HOST=localhost
DB_PORT=3306
DB_NAME=condominio_db
DB_USER=root
DB_PASS=

# Entorno de ejecución: development o production
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Condominio
