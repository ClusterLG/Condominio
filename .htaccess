# ========================================================
# Configuración de Seguridad y Servidor Apache / cPanel
# ========================================================

# Evitar navegación directa de directorios
Options -Indexes
DirectoryIndex index.php index.html

# Charset por defecto UTF-8
AddDefaultCharset UTF-8

# Bloquear acceso a archivos sensibles y de configuración
<FilesMatch "^(\.env|\.git|\.htaccess|composer\.(json|lock)|.*\.sql|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Proteger subcarpeta uploads contra ejecución de scripts maliciosos
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Si intentan ejecutar archivos php dentro de uploads, denegar acceso
    RewriteRule ^uploads/.*\.php$ - [F,L]
</IfModule>
